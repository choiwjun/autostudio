NAVER_CLIENT_ID=YOUR_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_CLIENT_SECRET
# 개발/테스트(로컬): sqlite:///data/keywords.db
# GitHub Actions(수집 배치): Supabase "Session pooler" (포트 5432)
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Vercel(서버리스 API): Supabase "Transaction pooler" (포트 6543)
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# 주의: db.<ref>.supabase.co 직결 주소는 무료 티어에서 IPv6 전용 → 사용 금지
DATABASE_URL=sqlite:///data/keywords.db
# ENV=production이면 DASHBOARD_TOKEN 필수 — 미설정 시 서버 기동 거부 (fail-closed, 스펙 §7 v3)
ENV=development
# 실행 잠금 stale 기준 — GH Actions timeout-minutes(60)와 정합 (v3: 30분은 장시간 실행이 회수될 수 있음)
RUN_LOCK_STALE_MINUTES=60
# 0 = 일일 신규 제한 없음 (ACTIVE_KEYWORD_CAP=500이 전체 안전 상한)
DAILY_NEW_KEYWORD_CAP=0
ACTIVE_KEYWORD_CAP=500
AUTOCOMPLETE_URL=https://ac.search.naver.com/nx/ac
AUTOCOMPLETE_MAX_DEPTH=2
AUTOCOMPLETE_MAX_REQUESTS=300
MANUAL_BUDGET_SECONDS=45
DASHBOARD_TOKEN=change-me
DATALAB_ENABLED=1
DATALAB_ANCHOR=냉장고
# v4: 쇼핑인사이트(검색 클릭 추이) 쇼핑 분야 코드 — 네이버쇼핑 cat_id (기본 생활/건강)
SHOPPING_INSIGHT_CATEGORY=50000000
# v22(B.2): 네이버쇼핑커넥트 파트너스 ID — 상품 블록 딥링크 변환
# (brandconnect.naver.com/affiliates/{PID}?channelProductNo={상품번호})
# 미설정 시 상품 블록은 원본 쇼핑 링크 유지
SHOPPING_CONNECT_PID=
# v7: 콘텐츠 자동화 — 블로그 이미지 생성용 Aliyun Bailian 키 (bl CLI / qwen 계열)
# 미설정 시 이미지 생성 API는 503("이미지 키가 필요합니다") — 텍스트 초안은 정상 동작
BAILIAN_TOKEN_PLAN_API_KEY=YOUR_BAILIAN_KEY
# v26: 이미지 프로바이더 폴백 — Bailian 이미지 호출 실패(쿼터 소진·장애) 시
# DashScope wanx2.1-t2i-turbo로 1회 재시도 (FR-1). **Bailian과 다른 계정의 키** 권장
# (같은 Alibaba 계정이면 쿼터 소진이 동시 발생해 폴백이 무의미).
# 미설정 시 폴백 경로가 비활성 — 기존 동작 100% 유지 (FR-2).
DASHSCOPE_API_KEY=
# v26: DashScope 리전별 호스트 오버라이드 (선택) — **키 발급 리전과 호스트가
# 다르면 인증 실패** (QA P2). 기본값은 베이징(중국 본토).
#   베이징(중국 본토)  = https://dashscope.aliyuncs.com        (기본값)
#   싱가포르·국제 리전 = https://dashscope-intl.aliyuncs.com
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# v27: Google Nano Banana (Gemini 이미지 모델) — 이미지 생성 1차 프로바이더 (FR-1).
# 설정 시 나노바나나 우선 호출 → 실패 시 Bailian → DashScope 체인으로 폴백.
# **미설정 시 기존 동작 100% 유지** (Bailian 1차 → DashScope 폴백).
# GEMINI_API_KEY만 설정된 환경도 이미지 생성 동작 (FR-6, image_gen 내부 가드).
# 발급: https://aistudio.google.com/apikey (유료 — 무료 티어 없음, 이미지당 ~$0.034~0.067)
GEMINI_API_KEY=
# 선택 — 나노바나나 모델 오버라이드 (기본 gemini-3.1-flash-image = Nano Banana 2)
#   gemini-3.1-flash-lite-image (Nano Banana 2 Lite, ~$0.017~0.034 — 최속·최저가)
#   gemini-3-pro-image (Nano Banana Pro, ~$0.134 — 블로그 삽화에 과분)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 선택 — 이미지 크기 (기본 1K. 2K/4K는 비용 증가 — env 오버라이드로만)
GEMINI_IMAGE_SIZE=1K
# 선택 — Gemini 엔드포인트 오버라이드 (기본 https://generativelanguage.googleapis.com)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# v8: 글 초안 생성용 Token Plan OpenAI 호환 API base URL (선택 — 기본값 내장)
# BAILIAN_TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# v23: 블로그 초안 LLM — OpenCode Go(zen/go, deepseek-v4-flash) 우선 사용.
# 설정 시 초안 생성이 OpenCode Go로 전환되고, 미설정이면 위 Bailian 키로 폴백.
# 키는 opencode auth.json(~/.local/share/opencode/auth.json의 opencode-go.key)에서 확인.
OPENCODE_GO_API_KEY=
# 선택 — OpenCode Go 엔드포인트 오버라이드 (기본 https://opencode.ai/zen/go/v1)
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# v17: 콘텐츠 배치 — 스케줄 수집(GH Actions)에서 초안·이미지 자동 생성.
# BAILIAN_TOKEN_PLAN_API_KEY가 있어야 동작하며, 미설정 시 배치는 조용히 생략.
CONTENT_BATCH_ENABLED=1
# v19: 배치 신규 초안 생성 플랫폼 (naver/tistory/adsense/brand — 기본 네이버)
CONTENT_BATCH_PLATFORM=naver
# 회당 신규 초안 생성 상한 (이미지 포함 — 1건당 수 분 소요 감안)
CONTENT_BATCH_MAX_NEW=2
# 콘텐츠 배치 전체 시간 예산(초) — GH Actions 잡 timeout(60분) 이내로
# (발굴·스냅샷·수요·쇼핑 단계와 합산해도 60분 미만이 되도록 v17.3에서 1200으로 축소)
CONTENT_BATCH_BUDGET_SECONDS=1200
# v22.3(2.x): 별도 블로그(autoblog) 발행 — 2.8 발행 클라이언트 + 3.3 운세 자동 발행
# 미설정 시 발행 단계 자체가 비활성 (품질 리뷰 후 BLOG_PUBLISH_ENABLED=1)
BLOG_API_URL=https://your-blog.vercel.app
BLOG_TOKEN=
BLOG_PUBLISH_ENABLED=0
# 고정 운세 콘텐츠(일주 60·별자리 12·띠 12) 일일 생성 상한
FORTUNE_FIXED_PER_DAY=2
